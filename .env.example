# Copy to .env (quickstart.sh does this automatically with random passwords) and adjust.
# docker compose reads .env from this directory.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=dashboard
DB_PASSWORD=change-me

# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# Python ML service used by dashboard-user (inference / training)
# host.docker.internal resolves to the Docker host (see extra_hosts in docker-compose.yml)
PYTHON_SERVICE_URL=http://host.docker.internal:5000

# JWT lifetime in seconds
JWT_LIFESPAN=3600
