####
# Dockerfile used by quarkus-container-image-docker to build the JVM image of dashboard-user.
#
# Build it from the repository root with:
#
#   ./mvnw -B clean package -DskipTests -Dquarkus.container-image.build=true
#
# which produces the image dashboard/dashboard-user:1.0-SNAPSHOT.
#
# Runtime configuration (see application.properties): DB_URL, DB_USER, DB_PASSWORD,
# DB_SCHEMA_STRATEGY, JWT_KEY_DIR (must contain sign-public.pem and enc-private.pem),
# SYSTEM_FOLDER (e.g. /data/GroupProject; mount a volume on /data), PYTHON_SERVICE_URL, CORS_ORIGINS.
#
# You can find more information about the UBI base runtime images and their configuration here:
# https://rh-openjdk.github.io/redhat-openjdk-containers/
###
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.23

ENV LANGUAGE='en_US:en'

# Writable data directory for uploaded models / resources / avatars (mount a volume here).
# A named volume mounted on /data inherits this ownership on first use.
USER root
RUN mkdir -p /data && chown 185:0 /data && chmod 0775 /data

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8081
USER 185
ENV SYSTEM_FOLDER=/data/GroupProject
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
